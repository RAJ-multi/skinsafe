# ============================================================
# SkinSafe Production & Development Environment Reference
# ============================================================
# DO NOT COMMIT ACTUAL SECRETS TO GIT.

# ------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Configure in Vercel Dashboard)
# ------------------------------------------------------------

# Production URL of your deployed Render backend (NO trailing slash)
# Example: https://skinsafe-backend.onrender.com
NEXT_PUBLIC_API_URL=https://your-backend.onrender.com

# Supabase Project URL (public)
NEXT_PUBLIC_SUPABASE_URL=https://wuzkbgjwrbwwvkyyxjem.supabase.co

# Supabase Anonymous / Publishable Key (public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_ZQvQ5gJT_HUzTevMOnBCzQ_fTwsg8jc


# ------------------------------------------------------------
# 2. BACKEND ENVIRONMENT VARIABLES (Configure in Render Dashboard)
# ------------------------------------------------------------

# Python version for Render native environment
PYTHON_VERSION=3.12.8

# Application environment
ENVIRONMENT=production

# Allowed frontend domains for CORS (comma-separated)
# Example: https://skinsafe.vercel.app,http://localhost:3000
CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000

# Regex pattern matching any Vercel preview or production deployment URL
CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# Google AI Studio Gemini API Key (SECRET - KEEP PRIVATE ON BACKEND)
GEMINI_API_KEY=AIzaSy...your-gemini-api-key...

# Gemini Model name (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
